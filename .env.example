# ============================================================
# LISA CRM - Root Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# Database
POSTGRES_DB=lisa_crm
POSTGRES_USER=lisa_user
POSTGRES_PASSWORD=change-this-strong-password-in-production

# Redis
REDIS_PASSWORD=change-this-redis-password

# JWT (Must be long random strings in production)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars

# Application URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
